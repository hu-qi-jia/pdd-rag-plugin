{
  "name": "pdd-cs-quick-reply",
  "displayName": "拼多多客服快捷回复",
  "version": "0.10.0",
  "description": "拼多多商家客服检索工具:自动记录买家问答,检索历史回复/标准回答/知识库一键填充,发送永远由人工完成。基于 personal-ai-memory 本地化改造。",
  "author": "Personal project",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:prod": "plasmo build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.13.0",
    "@xenova/transformers": "^2.17.2",
    "dexie": "^4.0.10",
    "lucide-react": "^0.575.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/chrome": "^0.0.323",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.6.2",
    "plasmo": "^0.90.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "manifest": {
    "permissions": [
      "storage",
      "unlimitedStorage",
      "offscreen",
      "alarms",
      "scripting"
    ],
    "host_permissions": [
      "https://mms.pinduoduo.com/*",
      "https://hf-mirror.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "action": {
      "default_title": "拼多多客服快捷回复",
      "default_popup": "popup.html"
    },
    "web_accessible_resources": [
      {
        "resources": ["assets/icon.png"],
        "matches": ["https://mms.pinduoduo.com/*"]
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "protobufjs",
      "sharp"
    ]
  }
}
